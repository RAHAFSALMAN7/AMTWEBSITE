# Production (see `.env.production` — default site: https://amt-arabia.net)
VITE_SITE_URL=https://amt-arabia.net

# Optional: Google Analytics 4
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Google Search Console (HTML tag verification content value)
# VITE_GSC_VERIFICATION=your_verification_string

# Optional post-build prerender (static HTML in dist/*/.../index.html):
#   npm i -D playwright && npx playwright install chromium
#   (Remove SKIP_PRERENDER if you set it.)
# SKIP_PRERENDER=1
